# ===========================================
# Dutchkem Voice Agent v3 — Environment Config
# ===========================================
# Copy to .env and fill in values before running:
#   cp .env.example .env

# --- Required (no defaults) ---
POSTGRES_PASSWORD=changeme
SECRET_KEY=changeme-use-a-secure-random-string
JWT_SECRET=changeme-use-a-secure-random-string

# --- Database ---
POSTGRES_DB=dutchkem_voice
POSTGRES_USER=dutchkem
POSTGRES_PORT=5432
MONGODB_DB=dutchkem_voice
MONGODB_PORT=27017
REDIS_PORT=6379

# --- Application ---
DEBUG=false
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- AI/ML ---
GPU_ENABLED=true
MODEL_CACHE_DIR=./models
