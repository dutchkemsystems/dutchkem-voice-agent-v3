# ===========================================
# Production Environment — fill before deploying
# ===========================================

# --- Required ---
SECRET_KEY=generate-a-secure-random-string
JWT_SECRET=generate-a-secure-random-string
POSTGRES_PASSWORD=generate-a-strong-password

# --- Database (from Render/Railway/Upstash) ---
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dutchkem_voice
MONGODB_URL=mongodb://user:pass@host:27017/dutchkem_voice
REDIS_URL=redis://default:pass@host:6379

# --- CORS (your frontend URL) ---
CORS_ORIGINS=["https://your-app.vercel.app"]

# --- Frontend ---
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
