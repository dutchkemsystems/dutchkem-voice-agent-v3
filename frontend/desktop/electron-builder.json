{
  "appId": "com.dutchkem.voice-agent",
  "productName": "DutchKem Voice Agent",
  "directories": {
    "output": "dist"
  },
  "files": [
    "main.js",
    "preload.js",
    "assets/**/*",
    "out/**/*"
  ],
  "win": {
    "target": "nsis",
    "icon": "assets/icon.ico"
  },
  "mac": {
    "target": "dmg",
    "icon": "assets/icon.icns"
  },
  "linux": {
    "target": "AppImage",
    "icon": "assets/icon.png"
  }
}
